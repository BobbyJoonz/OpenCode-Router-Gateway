# ---------------------------------------------------------------------------
# systemd unit — bare-metal install
#
#   sudo cp deploy/opencode-router.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now opencode-router
#   journalctl -u opencode-router -f
# ---------------------------------------------------------------------------
[Unit]
Description=OpenCode Router Gateway (rotating egress + OpenAI-compatible API)
Documentation=https://github.com/BobbyJoonz/OpenCode-Router-Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
WorkingDirectory=/opt/opencode-router
EnvironmentFile=/opt/opencode-router/.env
# Cap the heap so a leak fails fast instead of OOM-killing the host.
Environment=NODE_OPTIONS=--max-old-space-size=512
# Compiled output: no tsx/transpiler at runtime (lower RAM, faster start).
ExecStart=/usr/bin/node /opt/opencode-router/dist/backend/server.js
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# --- hardening -----------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/opencode-router/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
LimitNOFILE=65535
# Memory/process guards: the service is expected to use 150-250 MB.
MemoryHigh=768M
MemoryMax=1G
TasksMax=256

# --- logging -------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opencode-router

[Install]
WantedBy=multi-user.target
