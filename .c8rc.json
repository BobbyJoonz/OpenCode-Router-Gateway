{
  "all": true,
  "include": [
    "src/backend/parser/**",
    "src/backend/vpn/**",
    "src/backend/gateway/**",
    "src/backend/tester/**",
    "src/backend/observability/**",
    "src/backend/lifecycle.ts",
    "src/backend/security/**",
    "src/backend/db/**"
  ],
  "exclude": ["**/*.d.ts"],
  "reporter": ["text-summary", "text", "lcov", "json-summary"],
  "report-dir": "coverage",
  "clean": true,
  "check-coverage": true,
  "lines": 80,
  "functions": 85,
  "statements": 80,
  "branches": 70
}
