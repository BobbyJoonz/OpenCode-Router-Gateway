{
  "name": "opencode-router-gateway",
  "version": "2.1.0",
  "description": "OpenAI-compatible gateway with rotating Xray egress. Adds /v1 chat completions, API keys, quotas, bulk TCP pre-screening and a background node health monitor on top of OpenCode Router.",
  "main": "src/backend/server.ts",
  "author": "OpenCode Router Gateway contributors (based on OpenCode Router by Ehsan Shahriyari)",
  "license": "MIT",
  "homepage": "https://github.com/BobbyJoonz/OpenCode-Router-Gateway",
  "repository": {
    "type": "git",
    "url": "https://github.com/BobbyJoonz/OpenCode-Router-Gateway.git"
  },
  "bugs": {
    "url": "https://github.com/BobbyJoonz/OpenCode-Router-Gateway/issues"
  },
  "scripts": {
    "build:frontend": "cd src/frontend && npx vite build",
    "build": "npm run build:frontend",
    "start": "npx tsx src/backend/server.ts",
    "dev:backend": "npx tsx watch src/backend/server.ts",
    "dev:frontend": "cd src/frontend && npx vite",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:boundaries": "npx tsx tools/check-boundaries.ts",
    "test": "npx tsx tests/test-scenarios.ts",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:gateway": "npx tsx tests/gateway-tests.ts",
    "test:contract": "npx tsx tests/contract/upstream-contract.ts",
    "test:contract:live": "npx tsx tests/contract/upstream-contract.ts",
    "test:gateway:ci": "node tools/ci-gateway-tests.mjs",
    "test:lifecycle": "npx tsx tests/lifecycle-integration.ts",
    "test:no-opencode": "npx tsx tests/no-opencode.ts",
    "load": "node tools/load-run.mjs",
    "soak": "node tools/soak.mjs",
    "coverage": "c8 node --import tsx --test \"tests/unit/*.test.ts\"",
    "verify": "npm run typecheck && npm run lint && npm run check:boundaries && npm run test:unit && npm run test:contract && npm test && npm run test:gateway:ci && npm run test:lifecycle && npm run test:no-opencode && npm run coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "opencode",
    "opencode-router",
    "openai-compatible",
    "gateway",
    "api-gateway",
    "llm-proxy",
    "v2ray",
    "xray",
    "vless",
    "vmess",
    "trojan",
    "shadowsocks",
    "proxy",
    "egress-ip",
    "rate-limit",
    "rotation"
  ],
  "type": "commonjs",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "better-sqlite3": "12.6.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.6.2",
    "c8": "^12.0.0",
    "dependency-cruiser": "^18.7.2",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4"
  }
}
