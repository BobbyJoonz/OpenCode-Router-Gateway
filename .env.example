# ===========================================================================
# OpenCode Router Gateway — environment template
# Copy to .env and fill in the values you need.
# ===========================================================================

# --- web dashboard / backend ------------------------------------------------
PORT=3000

# --- local proxy engine -----------------------------------------------------
# These are the loopback ports Xray listens on. Change them if something else
# (v2rayN, another Xray, clash...) already owns 10808/10809.
OPENCODE_SOCKS_PROXY_PORT=10808
OPENCODE_HTTP_PROXY_PORT=10809

# Optional explicit path to the OpenCode CLI (auto-detected when omitted).
# OPENCODE_BIN=/usr/local/bin/opencode

# Optional explicit path to the Xray binary (defaults to ./bin/xray).
# XRAY_BIN=/usr/local/bin/xray

# --- workflow tuning --------------------------------------------------------
MAX_TEST_ATTEMPTS=25
OPENCODE_TIMEOUT_SECONDS=20

# --- remote access to the *management* API ----------------------------------
# Leave unset for loopback-only operation (recommended). If you enable remote
# access you MUST also set a strong API key, otherwise the server refuses to
# start with a non-loopback bind.
# ALLOW_REMOTE_ACCESS=true
# OPENCODE_ROUTER_API_KEY=change-me-to-a-long-random-string

# --- OpenAI-compatible gateway ---------------------------------------------
# The upstream provider the gateway forwards to. This is a REAL provider: the
# proxy only changes your egress IP, it does not grant model access.
GATEWAY_UPSTREAM_BASE_URL=https://api.openai.com/v1
GATEWAY_UPSTREAM_API_KEY=sk-your-real-provider-key
GATEWAY_UPSTREAM_MODEL=gpt-4o-mini

# Gateway switch is stored in the database (settings.gateway_enabled). It can be
# flipped at runtime:
#   curl -X PUT http://127.0.0.1:3000/api/settings \
#        -H 'content-type: application/json' -d '{"gateway_enabled":"true"}'

# --- optional mirrors -------------------------------------------------------
# Used by deploy/install.sh and start.sh when github.com is unreachable.
# XRAY_BASE=https://gh-proxy.com/https://github.com
